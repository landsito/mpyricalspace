*.dat filter=lfs diff=lfs merge=lfs -text
*.txt filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.asc filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.html filter=lfs diff=lfs merge=lfs -text

# Excluded from the *.txt LFS rule above: this file is tiny (376 bytes) and
# LFS content that fails to upload leaves a broken pointer with no local
# fallback (see native.txt's own git history) -- not worth the risk for a
# file this small; keep it a plain git blob instead.
native.txt !filter !diff !merge !text

# ==============================================================================
# GitHub Linguist Configuration
# ==============================================================================
# The core of this library is written in Python. Fortran source files are 
# included only for compilation purposes and backend execution. To prevent 
# Fortran from distorting the repository's language statistics due to file size, 
# we mark these files as vendored/dependencies.

*.f90 linguist-vendored
*.f linguist-vendored
