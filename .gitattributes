# Data files are plain git blobs, not Git LFS: together they are ~39 MB (the largest 14 MB), and LFS pointers
# break GitHub's source archives, `pip install git+...` and clones on machines without git-lfs, and hit the
# free LFS bandwidth quota. -text: never convert line endings -- the Fortran/C models read these files as is.
*.dat  -text
*.txt  -text
*.asc  -text
*.gz   -text
*.pdf  -text
*.tar  -text
*.zip  -text
*.html -text

# ==============================================================================
# GitHub Linguist Configuration
# ==============================================================================
# The core of this library is written in Python. Fortran source files are 
# included only for compilation purposes and backend execution. To prevent 
# Fortran from distorting the repository's language statistics due to file size, 
# we mark these files as vendored/dependencies.

*.f90 linguist-vendored
*.f linguist-vendored
